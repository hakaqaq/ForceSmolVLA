    "ratios": [0.8, 0.1, 0.1],
    "seed": "forcesmolvla-v4.1-task2-split-1",
    "normalizer_fit_scope": "train episodes only; state/wrench per tuple; action over every valid H=50 future target relative to its t_ref state; padded tail excluded",

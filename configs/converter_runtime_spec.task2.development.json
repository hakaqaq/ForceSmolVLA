      [5.6165622863812905e-06, 1.1233124572762581e-05, 5.6165622863812905e-06, 1.0, -1.8210503582611859, 0.8302914688064609],
      [1.0, 2.0, 1.0, 1.0, -1.9163030327246362, 0.9260275129309734]
    ],
    "warmup_samples": 250,
    "max_source_gap_ms": 9.0,
    "future_interpolation": "forbidden",

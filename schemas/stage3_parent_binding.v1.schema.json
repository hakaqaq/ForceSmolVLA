{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forcesmolvla.local/schemas/stage3_parent_binding.v1.schema.json",
  "title": "ForceSmolVLA approved hybrid Stage-3 parent binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "binding_type",
    "continuation_semantics",
    "actor_parent",
    "critic_parent",
    "target_critic_parent",
    "normalizer_binding",
    "action_contract_binding",
    "task_feature_binding",
    "calibration_binding",
    "runtime_contract_binding",
    "optimizer_policy",
    "initial_safety_state",
    "compatibility_evidence",
    "unverified_items",
    "authorization"
  ],
  "properties": {
    "schema_version": {
      "const": "forcesmolvla_stage3_parent_binding.v1.development"
    },
    "binding_id": {"type": "string", "minLength": 1},
    "binding_type": {"const": "new_hybrid_stage3_bootstrap"},
    "continuation_semantics": {"$ref": "#/$defs/continuation"},
    "actor_parent": {"$ref": "#/$defs/artifact"},
    "critic_parent": {"$ref": "#/$defs/artifact_group"},
    "target_critic_parent": {"$ref": "#/$defs/artifact_group"},
    "normalizer_binding": {"$ref": "#/$defs/artifact"},
    "action_contract_binding": {"$ref": "#/$defs/artifact"},
    "task_feature_binding": {"$ref": "#/$defs/task_artifact"},
    "calibration_binding": {"$ref": "#/$defs/artifact"},
    "runtime_contract_binding": {"$ref": "#/$defs/artifact"},
    "optimizer_policy": {"$ref": "#/$defs/optimizer"},
    "initial_safety_state": {"$ref": "#/$defs/safety"},
    "compatibility_evidence": {"type": "object", "minProperties": 1},
    "unverified_items": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "authorization": {"$ref": "#/$defs/authorization"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "logical_role",
        "selected",
        "absolute_path",
        "resolved_realpath",
        "format",
        "size_bytes",
        "sha256",
        "sha256_evidence",
        "required_files_or_keys",
        "architecture_binding",
        "load_validation_level"
      ],
      "properties": {
        "logical_role": {"type": "string", "minLength": 1},
        "selected": {"type": "boolean"},
        "absolute_path": {"type": "string", "pattern": "^/"},
        "resolved_realpath": {"type": "string", "pattern": "^/"},
        "format": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sha256_evidence": {"type": "string", "minLength": 1},
        "required_files_or_keys": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "architecture_binding": {"type": "object", "minProperties": 1},
        "load_validation_level": {"type": "string", "minLength": 1}
      }
    },
    "task_artifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "type": "object",
          "required": [
            "logical_object_sha256",
            "logical_object_sha256_evidence",
            "evidence_container_sha256"
          ],
          "properties": {
            "logical_object_sha256": {"$ref": "#/$defs/sha256"},
            "logical_object_sha256_evidence": {"type": "string", "minLength": 1},
            "evidence_container_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "artifact_group": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "logical_role",
        "selected",
        "source_id",
        "artifacts",
        "architecture_binding",
        "load_validation_level"
      ],
      "properties": {
        "logical_role": {"type": "string", "minLength": 1},
        "selected": {"const": true},
        "source_id": {"type": "string", "minLength": 1},
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "architecture_binding": {"type": "object", "minProperties": 1},
        "load_validation_level": {"type": "string", "minLength": 1}
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_binding_decision",
        "exact_phase2_continuation",
        "not_exact_phase2_cycle210_continuation",
        "cycle210_full_learner_checkpoint_available",
        "cycle210_full_learner_checkpoint_expected_path",
        "full_learner_resume",
        "actor_source_role",
        "critic_source_role"
      ],
      "properties": {
        "parent_binding_decision": {"const": "APPROVED_HYBRID"},
        "exact_phase2_continuation": {"const": false},
        "not_exact_phase2_cycle210_continuation": {"const": true},
        "cycle210_full_learner_checkpoint_available": {"const": false},
        "cycle210_full_learner_checkpoint_expected_path": {"type": "string", "pattern": "^/"},
        "full_learner_resume": {"const": false},
        "actor_source_role": {"const": "cycle210_evaluation_checkpoint_stage3_initial_actor"},
        "critic_source_role": {"const": "g7a_r2_online_and_target_twin_q"}
      }
    },
    "optimizer": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "inherit_actor_optimizer",
        "inherit_critic_optimizer",
        "inherit_scheduler",
        "inherit_rng",
        "inherit_sampler",
        "instantiated_in_this_round",
        "rebuild_spec_status",
        "actor_candidate",
        "critic_candidate"
      ],
      "properties": {
        "inherit_actor_optimizer": {"const": false},
        "inherit_critic_optimizer": {"const": false},
        "inherit_scheduler": {"const": false},
        "inherit_rng": {"const": false},
        "inherit_sampler": {"const": false},
        "instantiated_in_this_round": {"const": false},
        "rebuild_spec_status": {"const": "FROZEN"},
        "actor_candidate": {"type": "object", "minProperties": 1},
        "critic_candidate": {"type": "object", "minProperties": 1}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_actor_update_enabled",
        "initial_actor_q_guidance_enabled",
        "critic_warmup_required",
        "critic_ready",
        "unlock_requires_independent_critic_gate"
      ],
      "properties": {
        "initial_actor_update_enabled": {"const": false},
        "initial_actor_q_guidance_enabled": {"const": false},
        "critic_warmup_required": {"const": true},
        "critic_ready": {"const": false},
        "unlock_requires_independent_critic_gate": {"const": true}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpu_model_load",
        "real_model_forward",
        "optimizer_instantiation",
        "optimizer_step",
        "polyak_update",
        "robot_execution",
        "network_service"
      ],
      "properties": {
        "gpu_model_load": {"const": false},
        "real_model_forward": {"const": false},
        "optimizer_instantiation": {"const": false},
        "optimizer_step": {"const": false},
        "polyak_update": {"const": false},
        "robot_execution": {"const": false},
        "network_service": {"const": false}
      }
    }
  }
}

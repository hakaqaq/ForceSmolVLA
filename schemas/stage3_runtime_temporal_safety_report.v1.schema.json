{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forcesmolvla.local/schemas/stage3_runtime_temporal_safety_report.v1.schema.json",
  "title": "ForceSmolVLA Stage-3 runtime temporal safety evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result",
    "baseline",
    "temporal_facts",
    "runtime_contract",
    "normalization_audit",
    "production_gripper_blocker",
    "persistence_boundary",
    "tests",
    "checks",
    "production_blockers",
    "gates",
    "source_closure_sha256",
    "canonical_report_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "forcesmolvla_stage3_runtime_temporal_safety_report.v1"
    },
    "result": {"const": "PASS"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "parent_head", "scope"],
      "properties": {
        "branch": {"const": "stage3-online-hil"},
        "parent_head": {
          "const": "d9d6ecb468fb9301bf9b2196ecd32654fe7fd1c4"
        },
        "scope": {"const": "G7C1A_CPU_ONLY_PRE_FREEZE"}
      }
    },
    "temporal_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "H50_MODEL_TIMEBASE_HZ",
        "POSE_REFERENCE_DISPATCH_HZ",
        "CONTROLLER_INTERNAL_SERVO_HZ",
        "STAGE3_PROJECTION_GRID_HZ",
        "CONTRACT_TRANSITION_MACRO_HZ",
        "PRODUCTION_TRANSITION_COMMIT_HZ",
        "POLICY_REQUEST_TRIGGER",
        "POLICY_REQUEST_HZ_MEASURED",
        "POLICY_INFERENCE_10HZ_REQUIRED",
        "PRODUCTION_SAFE_INFERENCE_REFRESH_RATE"
      ],
      "properties": {
        "H50_MODEL_TIMEBASE_HZ": {"const": 30},
        "POSE_REFERENCE_DISPATCH_HZ": {"const": 10},
        "CONTROLLER_INTERNAL_SERVO_HZ": {"const": "UNVERIFIED"},
        "STAGE3_PROJECTION_GRID_HZ": {"const": 30},
        "CONTRACT_TRANSITION_MACRO_HZ": {"const": 10},
        "PRODUCTION_TRANSITION_COMMIT_HZ": {"const": "UNVERIFIED"},
        "POLICY_REQUEST_TRIGGER": {"const": "event_driven_low_watermark"},
        "POLICY_REQUEST_HZ_MEASURED": {"const": "UNVERIFIED"},
        "POLICY_INFERENCE_10HZ_REQUIRED": {"const": false},
        "PRODUCTION_SAFE_INFERENCE_REFRESH_RATE": {"const": "UNVERIFIED"}
      }
    },
    "runtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread_ownership",
        "cross_thread_call_fail_closed",
        "clock_domain_bound",
        "cross_clock_timestamp_rejected",
        "action_slot_fifo_present",
        "h50_actions_cached",
        "max_selections_per_adopted_chunk",
        "selected_index_policy",
        "current_low_watermark_approved"
      ],
      "properties": {
        "thread_ownership": {"const": "single_owner_event_loop_only"},
        "cross_thread_call_fail_closed": {"const": true},
        "clock_domain_bound": {"const": true},
        "cross_clock_timestamp_rejected": {"const": true},
        "action_slot_fifo_present": {"const": false},
        "h50_actions_cached": {"const": 50},
        "max_selections_per_adopted_chunk": {"const": 8},
        "selected_index_policy": {
          "const": "rational_time_based_sparse_selection"
        },
        "current_low_watermark_approved": {"const": false}
      }
    },
    "normalization_audit": {"$ref": "#/$defs/status_map"},
    "production_gripper_blocker": {"$ref": "#/$defs/gripper_blocker"},
    "persistence_boundary": {"$ref": "#/$defs/persistence_boundary"},
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collect_command",
        "collected_count",
        "node_ids",
        "full_command",
        "passed",
        "failed",
        "duration_seconds",
        "result"
      ],
      "properties": {
        "collect_command": {"type": "string", "minLength": 1},
        "collected_count": {"type": "integer", "minimum": 1},
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^tests/test_stage3_.*::"}
        },
        "full_command": {"type": "string", "minLength": 1},
        "passed": {"type": "integer", "minimum": 1},
        "failed": {"const": 0},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "result": {"const": "PASS"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_compile",
        "development_json_parse",
        "schema_validation",
        "git_diff_check",
        "stage3_import_side_effect",
        "cuda_initialized",
        "network_server_started",
        "ros_started",
        "robot_connection_count",
        "robot_command_count"
      ],
      "properties": {
        "python_compile": {"const": "PASS"},
        "development_json_parse": {"const": "PASS"},
        "schema_validation": {"const": "PASS"},
        "git_diff_check": {"const": "PASS"},
        "stage3_import_side_effect": {"const": "PASS"},
        "cuda_initialized": {"const": false},
        "network_server_started": {"const": false},
        "ros_started": {"const": false},
        "robot_connection_count": {"const": 0},
        "robot_command_count": {"const": 0}
      }
    },
    "production_blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G7C1_CPU_PRIMITIVES",
        "G7C1_FULL_REGRESSION",
        "G7C1_EVIDENCE_FROZEN",
        "PRODUCTION_CADENCE_BINDING_COMPLETE",
        "RECORDED_LIVE_TEMPORAL_PARITY",
        "G7_FORMAL_GATE_PASSED",
        "G8_STARTED",
        "ROBOT_EXECUTION_AUTHORIZED",
        "PUSHED"
      ],
      "properties": {
        "G7C1_CPU_PRIMITIVES": {"const": "PASS"},
        "G7C1_FULL_REGRESSION": {"const": "PASS"},
        "G7C1_EVIDENCE_FROZEN": {"const": true},
        "PRODUCTION_CADENCE_BINDING_COMPLETE": {"const": false},
        "RECORDED_LIVE_TEMPORAL_PARITY": {"const": false},
        "G7_FORMAL_GATE_PASSED": {"const": false},
        "G8_STARTED": {"const": false},
        "ROBOT_EXECUTION_AUTHORIZED": {"const": false},
        "PUSHED": {"const": false}
      }
    },
    "source_closure_sha256": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "canonical_report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "OBSERVATION_STATE_NORMALIZATION_ONCE",
        "OBSERVATION_WRENCH_NORMALIZATION_ONCE",
        "ACTION_DELTA_DENORMALIZATION_ONCE",
        "RECORDED_LIVE_ACCEPTED_MACRO_NORMALIZATION_ONCE"
      ],
      "properties": {
        "OBSERVATION_STATE_NORMALIZATION_ONCE": {"const": "code-audited"},
        "OBSERVATION_WRENCH_NORMALIZATION_ONCE": {"const": "code-audited"},
        "ACTION_DELTA_DENORMALIZATION_ONCE": {"const": "code-audited"},
        "RECORDED_LIVE_ACCEPTED_MACRO_NORMALIZATION_ONCE": {
          "const": "UNVERIFIED"
        }
      }
    },
    "gripper_blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GRIPPER_NOOP_ACK_POLICY",
        "FULL_ACTION7_ACK_CLOSURE",
        "PRODUCTION_INTEGRATION_BLOCKED_ON_GRIPPER_ACK"
      ],
      "properties": {
        "GRIPPER_NOOP_ACK_POLICY": {"const": "UNBOUND"},
        "FULL_ACTION7_ACK_CLOSURE": {"const": false},
        "PRODUCTION_INTEGRATION_BLOCKED_ON_GRIPPER_ACK": {"const": true}
      }
    },
    "persistence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "RUNTIME_LEDGER_PERSISTED",
        "PRODUCTION_RUNTIME_LEDGER_RESUME",
        "G5_PRODUCTION_DURABLE_RESUME"
      ],
      "properties": {
        "RUNTIME_LEDGER_PERSISTED": {"const": false},
        "PRODUCTION_RUNTIME_LEDGER_RESUME": {"const": "UNVERIFIED"},
        "G5_PRODUCTION_DURABLE_RESUME": {"const": "UNVERIFIED"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forcesmolvla.local/schemas/stage3_policy_revision.v1.schema.json",
  "title": "ForceSmolVLA isolated immutable policy revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "synthetic_revision_payload", "revision_id",
    "model", "files", "files_tree_sha256", "bindings", "canonical_manifest_digest"
  ],
  "properties": {
    "schema_version": {"const": "forcesmolvla_stage3_policy_revision.v1"},
    "artifact_kind": {"const": "isolated_immutable_policy_revision"},
    "synthetic_revision_payload": {"const": true},
    "revision_id": {"$ref": "#/$defs/sha256"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "payload_sha256", "tree_sha256", "files"],
      "properties": {
        "format": {"const": "deterministic_tiny_synthetic_bytes"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "files": {"$ref": "#/$defs/nonempty_files"}
      }
    },
    "files": {"$ref": "#/$defs/nonempty_files"},
    "files_tree_sha256": {"$ref": "#/$defs/sha256"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "canonical_manifest_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "size_bytes"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/nonempty"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "nonempty_files": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}
    },
    "file_group": {
      "type": "object",
      "required": ["tree_sha256", "files"],
      "properties": {
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "files": {"$ref": "#/$defs/nonempty_files"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learner_checkpoint", "approved_hybrid_parent", "recursive_source",
        "resolved_stage3_configs", "contracts", "temporal_action_dimensions",
        "vendor", "runtime_environment"
      ],
      "properties": {
        "learner_checkpoint": {
          "type": "object", "additionalProperties": false,
          "required": ["identity", "canonical_digest", "synthetic"],
          "properties": {
            "identity": {"$ref": "#/$defs/nonempty"},
            "canonical_digest": {"$ref": "#/$defs/sha256"},
            "synthetic": {"const": true}
          }
        },
        "approved_hybrid_parent": {
          "type": "object", "additionalProperties": false,
          "required": ["binding_id", "decision", "path", "sha256"],
          "properties": {
            "binding_id": {"$ref": "#/$defs/nonempty"},
            "decision": {"const": "APPROVED_HYBRID"},
            "path": {"$ref": "#/$defs/nonempty"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "recursive_source": {
          "allOf": [
            {"$ref": "#/$defs/file_group"},
            {
              "type": "object",
              "required": ["algorithm", "coverage", "production_source_binding"],
              "properties": {
                "algorithm": {"const": "sha256(canonical_json(sorted(relative_path,size_bytes,sha256)))"},
                "coverage": {
                  "type": "object", "additionalProperties": false,
                  "required": [
                    "forcesmolvla_recursive_python", "stage3_configs", "contracts",
                    "vendor_smolvla", "environment_metadata", "deployment_recorder_protocol_when_present"
                  ],
                  "properties": {
                    "forcesmolvla_recursive_python": {"const": true},
                    "stage3_configs": {"const": true},
                    "contracts": {"const": true},
                    "vendor_smolvla": {"const": true},
                    "environment_metadata": {"const": true},
                    "deployment_recorder_protocol_when_present": {"const": true}
                  }
                },
                "production_source_binding": {
                  "type": "object", "additionalProperties": false,
                  "required": ["complete", "present", "blockers"],
                  "properties": {
                    "complete": {"type": "boolean"},
                    "present": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
                    "blockers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}
                  }
                }
              }
            }
          ]
        },
        "resolved_stage3_configs": {"$ref": "#/$defs/file_group"},
        "contracts": {
          "type": "object", "additionalProperties": false,
          "required": [
            "action_contract", "normalizer", "calibration", "wrench_contract",
            "reward_rulespec", "task_feature", "trainability"
          ],
          "properties": {
            "action_contract": {"$ref": "#/$defs/file_group"},
            "normalizer": {"$ref": "#/$defs/file_group"},
            "calibration": {"$ref": "#/$defs/file_group"},
            "wrench_contract": {"$ref": "#/$defs/file_group"},
            "reward_rulespec": {"$ref": "#/$defs/file_group"},
            "task_feature": {"$ref": "#/$defs/file_group"},
            "trainability": {"$ref": "#/$defs/file_group"}
          }
        },
        "temporal_action_dimensions": {
          "type": "object", "additionalProperties": false,
          "required": [
            "policy_hz", "controller_hz", "flow_horizon", "critic_slots",
            "state_features", "wrench_features", "action_features", "camera_count"
          ],
          "properties": {
            "policy_hz": {"const": 10},
            "controller_hz": {"const": 30},
            "flow_horizon": {"const": 50},
            "critic_slots": {"const": 3},
            "state_features": {"const": 7},
            "wrench_features": {"const": 6},
            "action_features": {"const": 7},
            "camera_count": {"const": 2}
          }
        },
        "vendor": {
          "allOf": [
            {"$ref": "#/$defs/file_group"},
            {
              "type": "object", "required": ["path", "commit"],
              "properties": {
                "path": {"const": "vendor/lerobot"},
                "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
              }
            }
          ]
        },
        "runtime_environment": {
          "type": "object", "additionalProperties": false,
          "required": ["environment_lock", "python_runtime", "cuda_visible_devices"],
          "properties": {
            "environment_lock": {"$ref": "#/$defs/file"},
            "python_runtime": {"$ref": "#/$defs/nonempty"},
            "cuda_visible_devices": {"const": ""}
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forcesmolvla.local/schemas/stage3_gpu_preflight_report.v1.schema.json",
  "title": "ForceSmolVLA Stage-3 isolated GPU numerical preflight report v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "tool_status",
    "preflight_only",
    "environment",
    "parent_load",
    "data",
    "optimizer_ownership",
    "cycles",
    "numerics",
    "performance",
    "safety",
    "parent_checkpoint_mutated",
    "runtime_optimizer_state_persisted",
    "policy_revision_exported",
    "robot_execution_authorized",
    "evidence_freeze",
    "eta_gradient_diagnostic",
    "canonical_report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "forcesmolvla_stage3_gpu_preflight_report.v1"},
    "tool_status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "preflight_only": {"const": true},
    "environment": {
      "type": "object",
      "required": ["cuda_device_index", "gpu_name", "gpu_uuid", "python_executable", "torch_version", "torch_cuda_version", "cudnn_version", "initial_free_vram_mib"],
      "properties": {
        "cuda_device_index": {"type": "integer", "minimum": 0},
        "gpu_name": {"type": "string", "minLength": 1},
        "gpu_uuid": {"type": "string", "minLength": 1},
        "python_executable": {"type": "string", "minLength": 1},
        "torch_version": {"type": "string", "minLength": 1},
        "torch_cuda_version": {"type": "string", "minLength": 1},
        "cudnn_version": {"type": "integer", "minimum": 1},
        "initial_free_vram_mib": {"type": "number", "minimum": 0}
      }
    },
    "parent_load": {
      "type": "object",
      "required": ["actor_strict_load", "critic_strict_load", "target_critic_strict_load", "sha_before_after_equal"],
      "properties": {
        "actor_strict_load": {"type": "boolean"},
        "critic_strict_load": {"type": "boolean"},
        "target_critic_strict_load": {"type": "boolean"},
        "sha_before_after_equal": {"type": "boolean"}
      }
    },
    "data": {
      "type": "object",
      "required": ["critic_batch", "actor_batch", "normalizer_binding", "task_feature_digest", "writes_real_replay"],
      "properties": {
        "writes_real_replay": {"const": false}
      }
    },
    "optimizer_ownership": {
      "type": "object",
      "required": ["factory_validated", "actor_critic_parameter_id_intersection", "frozen_parameters_in_optimizers", "target_parameters_in_optimizers", "fresh_initial_state_entries", "each_trainable_parameter_exactly_one_owner"],
      "properties": {
        "factory_validated": {"type": "boolean"},
        "actor_critic_parameter_id_intersection": {"const": 0},
        "frozen_parameters_in_optimizers": {"const": 0},
        "target_parameters_in_optimizers": {"const": 0},
        "fresh_initial_state_entries": {"const": 0},
        "each_trainable_parameter_exactly_one_owner": {"type": "boolean"}
      }
    },
    "cycles": {
      "type": "object",
      "required": ["warmup_joint_cycles", "measured_joint_cycles", "critic_optimizer_steps", "actor_optimizer_steps", "target_polyak_steps"],
      "properties": {
        "warmup_joint_cycles": {"const": 1},
        "measured_joint_cycles": {"const": 3},
        "critic_optimizer_steps": {"const": 8},
        "actor_optimizer_steps": {"const": 4},
        "target_polyak_steps": {"const": 8}
      }
    },
    "numerics": {
      "type": "object",
      "required": ["all_finite", "frozen_hash_unchanged", "calql_online_call_count", "gradient_ownership_passed"],
      "properties": {
        "all_finite": {"type": "boolean"},
        "frozen_hash_unchanged": {"type": "boolean"},
        "calql_online_call_count": {"const": 0},
        "gradient_ownership_passed": {"type": "boolean"}
      }
    },
    "performance": {
      "type": "object",
      "required": ["load_only_vram_mib", "warmup_peak_vram_mib", "measured_peak_vram_mib", "final_vram_mib", "peak_cpu_rss_mib", "oom_count", "nonfinite_count"]
    },
    "safety": {
      "type": "object",
      "required": ["CRITIC_READY", "ACTOR_Q_GUIDANCE_ENABLED", "G0_FORMAL_GATE_PASSED", "G3_RECORDED_FIXTURE_LOOPBACK", "G5_AND_LATER", "ROBOT_CONNECTION_COUNT", "ROBOT_COMMAND_COUNT"]
    },
    "parent_checkpoint_mutated": {"const": false},
    "runtime_optimizer_state_persisted": {"const": false},
    "policy_revision_exported": {"const": false},
    "robot_execution_authorized": {"const": false},
    "evidence_freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G4P_RESULT",
        "R_SOURCE",
        "REAL_ONLINE_R_USED",
        "PREFLIGHT_ACTOR_STEPS_DISPOSABLE",
        "PRODUCTION_ACTOR_STATE_MUTATED",
        "RUNTIME_OPTIMIZER_STATE_PERSISTED",
        "CRITIC_WARMUP_STARTED",
        "CRITIC_READY",
        "ACTOR_Q_GUIDANCE_ENABLED",
        "ETA_3_APPROVED",
        "GPU_COEXISTENCE_VALIDATED",
        "G5_AND_LATER",
        "ROBOT_EXECUTION_AUTHORIZED"
      ],
      "properties": {
        "G4P_RESULT": {"const": "PASS"},
        "R_SOURCE": {"const": "synthetic_preflight_R_only"},
        "REAL_ONLINE_R_USED": {"const": false},
        "PREFLIGHT_ACTOR_STEPS_DISPOSABLE": {"const": true},
        "PRODUCTION_ACTOR_STATE_MUTATED": {"const": false},
        "RUNTIME_OPTIMIZER_STATE_PERSISTED": {"const": false},
        "CRITIC_WARMUP_STARTED": {"const": false},
        "CRITIC_READY": {"const": false},
        "ACTOR_Q_GUIDANCE_ENABLED": {"const": false},
        "ETA_3_APPROVED": {"const": false},
        "GPU_COEXISTENCE_VALIDATED": {"const": false},
        "G5_AND_LATER": {"const": "NOT_RUN"},
        "ROBOT_EXECUTION_AUTHORIZED": {"const": false}
      }
    },
    "eta_gradient_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_fields", "preflight_eta", "candidate_eta", "candidate_approved", "per_cycle", "statements"],
      "properties": {
        "source_fields": {
          "const": [
            "actor_updates[].gradient_geometry.weighted_q_norm",
            "actor_updates[].gradient_geometry.weighted_fm_norm"
          ]
        },
        "preflight_eta": {"const": 0.1},
        "candidate_eta": {"const": 3.0},
        "candidate_approved": {"const": false},
        "per_cycle": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cycle", "weighted_q_norm", "weighted_fm_norm", "weighted_q_over_weighted_fm", "eta_3_linear_rescale_q_over_fm"],
            "properties": {
              "cycle": {"type": "integer", "minimum": 0, "maximum": 3},
              "weighted_q_norm": {"type": "number", "minimum": 0},
              "weighted_fm_norm": {"type": "number", "exclusiveMinimum": 0},
              "weighted_q_over_weighted_fm": {"type": "number", "minimum": 0},
              "eta_3_linear_rescale_q_over_fm": {"type": "number", "minimum": 0}
            }
          }
        },
        "statements": {
          "const": [
            "eta=3 remains a provisional numerical-preflight candidate.",
            "No eta calibration or Actor Q-guidance approval is granted by G4P."
          ]
        }
      }
    },
    "canonical_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

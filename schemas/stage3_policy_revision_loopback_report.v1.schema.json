{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forcesmolvla.local/schemas/stage3_policy_revision_loopback_report.v1.schema.json",
  "title": "ForceSmolVLA G6P isolated policy revision loopback report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scope", "baseline", "revision_artifacts", "source_binding",
    "lifecycle", "one_episode_one_revision", "quiescent_gate", "stale_drop",
    "transition_binding", "checkpoint_round_trip", "fresh_process_recovery",
    "fault_injection", "production_blockers",
    "G6P_IMPLEMENTED", "G6P_IMMUTABLE_EXPORT", "G6P_ATOMIC_PUBLICATION",
    "G6P_INVALID_CANDIDATE_REJECTION", "G6P_ONE_EPISODE_ONE_REVISION",
    "G6P_QUIESCENT_ACTIVATION_GATE", "G6P_OLD_CHUNK_INVALIDATION", "G6P_ROLLBACK",
    "G6P_PENDING_RESTART_RECOVERY", "G6P_TRANSITION_REVISION_BINDING",
    "G6P_CANONICAL_DIGEST_REPEATABLE", "G6P_LOOPBACK_ACTIVATION", "G6P_RESULT",
    "SYNTHETIC_REVISION_PAYLOAD", "REAL_LEARNER_REVISION_USED",
    "REAL_POLICY_MODEL_EXPORTED", "REAL_POLICY_SERVER_USED", "REAL_RESET_HOME_VERIFIED",
    "PRODUCTION_WAL_SEALED_VERIFIED", "DIRECT_PUBLIC_HTTP_PARITY_VALIDATED",
    "PRODUCTION_SOURCE_BINDING_COMPLETE", "PRODUCTION_POLICY_PUBLICATION_VALIDATED",
    "PRODUCTION_POLICY_ACTIVATION", "POLICY_REVISION_ACTIVATED", "G6_FORMAL_GATE_PASSED",
    "G3_RECORDED_FIXTURE_LOOPBACK", "G5_PRODUCTION_DURABLE_RESUME",
    "CRITIC_WARMUP_STARTED", "CRITIC_READY", "ACTOR_Q_GUIDANCE_ENABLED",
    "CUDA_INITIALIZED", "NETWORK_SERVER_STARTED", "ROBOT_CONNECTION_COUNT",
    "ROBOT_COMMAND_COUNT", "ROBOT_EXECUTION_AUTHORIZED", "G7_AND_LATER", "PUSHED",
    "canonical_report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "forcesmolvla_stage3_policy_revision_loopback_report.v1"},
    "scope": {"const": "G6P_isolated_immutable_policy_revision_lifecycle_loopback"},
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "head", "g5p_report_canonical_sha256", "g5p_checkpoint_canonical_digest"],
      "properties": {
        "branch": {"const": "stage3-online-hil"},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "required_freeze_ancestor": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "freeze_ancestor_verified": {"const": true},
        "historical_evidence_verified": {"const": true},
        "historical_report_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "historical_report_file_sha256": {"$ref": "#/$defs/sha256"},
        "historical_markdown_file_sha256": {"$ref": "#/$defs/sha256"},
        "g5p_report_canonical_sha256": {"const": "75c3b0bab63b17bc0b4a685cd1a2177d7194fc82a1b2fd2fb112bc268210fdad"},
        "g5p_checkpoint_canonical_digest": {"const": "b0d24880e02f0eff3f18f22930b3fe8bbc1ebd8f9cfa9da825d27a08533d1058"}
      },
      "allOf": [{
        "if": {
          "properties": {
            "head": {"not": {"const": "0698f7635f479a36794c349ce0e1e77a3a26bc2d"}}
          }
        },
        "then": {
          "required": [
            "required_freeze_ancestor", "freeze_ancestor_verified",
            "historical_evidence_verified", "historical_report_canonical_sha256",
            "historical_report_file_sha256", "historical_markdown_file_sha256"
          ]
        }
      }]
    },
    "revision_artifacts": {
      "type": "object",
      "required": [
        "stable", "activated_then_rolled_back", "pending", "rejected",
        "orphan_not_registered", "idempotent_same_revision_same_digest",
        "immutable_permissions_validated", "completion_marker_written_last_by_implementation"
      ],
      "properties": {
        "stable": {"$ref": "#/$defs/revision"},
        "activated_then_rolled_back": {"$ref": "#/$defs/revision"},
        "pending": {"$ref": "#/$defs/revision"},
        "rejected": {"allOf": [{"$ref": "#/$defs/revision"}, {"required": ["reason"]}]},
        "orphan_not_registered": {"$ref": "#/$defs/revision"},
        "idempotent_same_revision_same_digest": {"const": true},
        "immutable_permissions_validated": {"const": true},
        "completion_marker_written_last_by_implementation": {"const": true}
      }
    },
    "source_binding": {
      "type": "object",
      "required": [
        "tree_sha256", "file_count", "resolved_stage3_config_tree_sha256",
        "vendor_commit", "vendor_tree_sha256", "environment_lock_sha256",
        "coverage", "production_source_binding"
      ],
      "properties": {
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "resolved_stage3_config_tree_sha256": {"$ref": "#/$defs/sha256"},
        "vendor_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "vendor_tree_sha256": {"$ref": "#/$defs/sha256"},
        "environment_lock_sha256": {"$ref": "#/$defs/sha256"},
        "coverage": {"type": "object"},
        "production_source_binding": {"type": "object"}
      }
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "active_revision_id", "pending_revision_id", "previous_revision_id", "policy_epoch",
        "publication_counters", "records", "pending_on_rollback_rule",
        "pending_auto_activated_on_rollback", "policy_revision_id_distinct_from_policy_epoch"
      ],
      "properties": {
        "active_revision_id": {"$ref": "#/$defs/sha256"},
        "pending_revision_id": {"$ref": "#/$defs/sha256"},
        "previous_revision_id": {"type": ["string", "null"]},
        "policy_epoch": {"type": "integer", "minimum": 1},
        "publication_counters": {"type": "object"},
        "records": {"type": "array", "minItems": 4},
        "pending_on_rollback_rule": {"const": "retain_pending_no_auto_activation"},
        "pending_auto_activated_on_rollback": {"const": false},
        "policy_revision_id_distinct_from_policy_epoch": {"const": true}
      }
    },
    "one_episode_one_revision": {"type": "object"},
    "quiescent_gate": {"type": "object"},
    "stale_drop": {"type": "object"},
    "transition_binding": {"type": "object"},
    "checkpoint_round_trip": {"type": "object"},
    "fresh_process_recovery": {
      "type": "object",
      "required": [
        "active_revision_id", "pending_revision_id", "previous_revision_id", "policy_epoch",
        "publication_counters", "safe_reset_required", "action_authorization_allowed",
        "rejected_and_rolled_back_records_recovered", "revision_digests_recovered"
      ],
      "properties": {
        "safe_reset_required": {"const": true},
        "action_authorization_allowed": {"const": false},
        "rejected_and_rolled_back_records_recovered": {"const": true},
        "revision_digests_recovered": {"const": true}
      }
    },
    "fault_injection": {
      "type": "object", "additionalProperties": false,
      "required": ["all_passed", "cases"],
      "properties": {
        "all_passed": {"const": true},
        "cases": {
          "type": "object",
          "required": [
            "model_tamper", "manifest_tamper", "source_config_binding_mismatch",
            "missing_completion_marker", "revision_id_digest_collision",
            "crash_before_atomic_rename", "crash_after_rename_before_pending_pointer",
            "registry_crash_before_atomic_replace", "stage_valid_candidate_during_active_episode",
            "invalid_candidate_rejection", "activation_with_active_episode",
            "activation_with_inflight_request", "activation_with_queued_action",
            "activation_with_unconsumed_ack", "activation_with_unsealed_wal_witness",
            "activation_without_reset_home_witness", "candidate_validation_incomplete",
            "old_revision_chunk_request", "policy_epoch_mismatch", "cross_revision_transition",
            "pending_survives_restart", "illegal_mid_episode_rollback",
            "learner_stall_active_unchanged"
          ]
        }
      }
    },
    "production_blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "G6P_IMPLEMENTED": {"const": true},
    "G6P_IMMUTABLE_EXPORT": {"const": "PASS"},
    "G6P_ATOMIC_PUBLICATION": {"const": "PASS"},
    "G6P_INVALID_CANDIDATE_REJECTION": {"const": "PASS"},
    "G6P_ONE_EPISODE_ONE_REVISION": {"const": "PASS"},
    "G6P_QUIESCENT_ACTIVATION_GATE": {"const": "PASS"},
    "G6P_OLD_CHUNK_INVALIDATION": {"const": "PASS"},
    "G6P_ROLLBACK": {"const": "PASS"},
    "G6P_PENDING_RESTART_RECOVERY": {"const": "PASS"},
    "G6P_TRANSITION_REVISION_BINDING": {"const": "PASS"},
    "G6P_CANONICAL_DIGEST_REPEATABLE": {"const": true},
    "G6P_LOOPBACK_ACTIVATION": {"const": true},
    "G6P_RESULT": {"const": "PASS"},
    "SYNTHETIC_REVISION_PAYLOAD": {"const": true},
    "REAL_LEARNER_REVISION_USED": {"const": false},
    "REAL_POLICY_MODEL_EXPORTED": {"const": false},
    "REAL_POLICY_SERVER_USED": {"const": false},
    "REAL_RESET_HOME_VERIFIED": {"const": false},
    "PRODUCTION_WAL_SEALED_VERIFIED": {"const": false},
    "DIRECT_PUBLIC_HTTP_PARITY_VALIDATED": {"const": false},
    "PRODUCTION_SOURCE_BINDING_COMPLETE": {"const": false},
    "PRODUCTION_POLICY_PUBLICATION_VALIDATED": {"const": false},
    "PRODUCTION_POLICY_ACTIVATION": {"const": false},
    "POLICY_REVISION_ACTIVATED": {"const": false},
    "G6_FORMAL_GATE_PASSED": {"const": false},
    "G3_RECORDED_FIXTURE_LOOPBACK": {"const": "BLOCKED"},
    "G5_PRODUCTION_DURABLE_RESUME": {"const": "UNVERIFIED"},
    "CRITIC_WARMUP_STARTED": {"const": false},
    "CRITIC_READY": {"const": false},
    "ACTOR_Q_GUIDANCE_ENABLED": {"const": false},
    "CUDA_INITIALIZED": {"const": false},
    "NETWORK_SERVER_STARTED": {"const": false},
    "ROBOT_CONNECTION_COUNT": {"const": 0},
    "ROBOT_COMMAND_COUNT": {"const": 0},
    "ROBOT_EXECUTION_AUTHORIZED": {"const": false},
    "G7_AND_LATER": {"const": "NOT_RUN"},
    "PUSHED": {"const": false},
    "canonical_report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {
      "type": "object",
      "required": ["revision_id", "model_sha256", "canonical_manifest_digest"],
      "properties": {
        "revision_id": {"$ref": "#/$defs/sha256"},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_manifest_digest": {"$ref": "#/$defs/sha256"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
